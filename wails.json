{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "safe-wheel",
  "outputfilename": "safe-wheel",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "buildtags": ["webkit2_41"],
  "preBuildHooks": {
    "*/*": "sh -c \"cd \\\"$(git rev-parse --show-toplevel)\\\" && magick frontend/src/assets/img/logo.webp -resize 1024x1024 build/appicon.png\""
  },
  "author": {
    "name": "quonaro",
    "email": "quonaro@mail.ru"
  },
  "info": {
    "companyName": "SafeWheel Team",
    "productName": "SafeWheel",
    "productVersion": "3.0.0",
    "copyright": "Copyright © 2026 SafeWheel Team",
    "comments": "Управление конкурсами «Безопасное колесо»"
  }
}
