{
  "name": "safewheel",
  "version": "1.0.0",
  "description": "Desktop приложение SafeWheel с Electron, Vue и встроенным Node.js сервером",
  "author": "SafeWheel Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "NODE_ENV=development electron . --no-sandbox",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "build:win": "npm run clean && npm run build:frontend && electron-builder --win nsis",
    "clean": "rm -rf dist/win-unpacked dist/*.exe dist/*.AppImage",
    "start": "NODE_ENV=production electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.safewheel.app",
    "productName": "SafeWheel",
    "directories": {
      "output": "dist",
      "buildResources": "build",
      "app": "."
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "node_modules/better-sqlite3/**/*",
      "package.json",
      "!node_modules/**/*",
      "!frontend/node_modules/**/*",
      "!frontend/src/**/*",
      "!frontend/*.config.js",
      "!frontend/package*.json",
      "!build.sh",
      "!dist/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/.git/**/*",
      "!**/.gitignore",
      "!**/README.md",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/spec/**/*",
      "!**/coverage/**/*",
      "!**/.nyc_output/**/*",
      "!**/.eslintrc*",
      "!**/.prettierrc*",
      "!**/jest.config*",
      "!**/webpack.config*",
      "!**/vite.config*",
      "!**/rollup.config*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "icon": "build/icon.ico",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "publisherName": "SafeWheel Team",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage",
        "--disable-gpu-sandbox",
        "--disable-software-rasterizer",
        "--no-zygote",
        "--single-process"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "desktop": {
        "Name": "SafeWheel",
        "Comment": "Desktop приложение SafeWheel",
        "Keywords": "safewheel;competition;results;",
        "StartupWMClass": "safewheel"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SafeWheel",
      "artifactName": "SafeWheel Setup ${version}.${ext}",
      "uninstallDisplayName": "SafeWheel ${version}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "perMachine": false,
      "allowElevation": true,
      "warningsAsErrors": false,
      "displayLanguageSelector": false,
      "installerLanguages": ["en_US", "ru_RU"]
    },
    "publish": null
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "node-fetch": "^2.7.0"
  }
}
