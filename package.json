{
  "name": "safewheel",
  "version": "1.0.0",
  "description": "Desktop приложение SafeWheel с Electron, Vue и встроенным Node.js сервером",
  "author": "SafeWheel Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "NODE_ENV=development electron . --no-sandbox",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "start": "NODE_ENV=production electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.safewheel.app",
    "productName": "SafeWheel",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "publisherName": "SafeWheel Team"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage",
        "--disable-gpu-sandbox",
        "--disable-software-rasterizer",
        "--no-zygote",
        "--single-process"
      ],
      "category": "Utility",
      "desktop": {
        "Name": "SafeWheel",
        "Comment": "Desktop приложение SafeWheel",
        "Keywords": "safewheel;competition;results;",
        "StartupWMClass": "safewheel"
      }
    },
        "nsis": {
          "oneClick": false,
          "allowToChangeInstallationDirectory": true,
          "createDesktopShortcut": true,
          "createStartMenuShortcut": true,
          "shortcutName": "SafeWheel",
          "artifactName": "SafeWheel Setup ${version}.${ext}",
          "uninstallDisplayName": "SafeWheel ${version}"
        },
    "publish": null
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "node-fetch": "^2.7.0"
  }
}
